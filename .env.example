# ─── MAMMOTH CAFE — environment variables ───────────────────────────────
# Copy to .env (never commit .env). Run `npm run admin:setup` to generate
# the admin hash + session secret automatically.

# Public site URL (used for SEO metadata, sitemap, structured data)
SITE_URL=https://example.com

# Port for `npm start` / PM2 (keep it different from other apps on the server)
PORT=3100

# Admin login. The password is stored only as a scrypt hash.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Random 32+ byte secret used to sign admin session cookies
SESSION_SECRET=

# Where the menu database file and uploaded images live (outside the repo
# is recommended in production so deployments never overwrite it)
DATA_DIR=./data

# Set to "false" ONLY while testing over plain http (before SSL is set up)
COOKIE_SECURE=true
